<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="atm"/>
        <attribute name="authors" value="Keisha Achmad YK"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-19 05:05:12 PM"/>
        <attribute name="created" value="S2Vpc2hhIEFjaG1hZCBZSztLRUlTSEFBQ0hNQURGSUE7MjAyNi0wOS0xNjsxMDoxNzo0OSBQTTszNzUw"/>
        <attribute name="edited" value="S2Vpc2hhIEFjaG1hZCBZSztLRUlTSEFBQ0hNQURGSUE7MjAyNi0wOS0xOTswNTowNToxMiBQTTsyOzM4NTM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="pinInput" type="String" array="False" size=""/>
            <declare name="kesempatan" type="Integer" array="False" size=""/>
            <declare name="berhasil" type="Boolean" array="False" size=""/>
            <assign variable="kesempatan" expression="3"/>
            <assign variable="berhasil" expression="False"/>
            <while expression="kesempatan &gt; 0 and berhasil == False">
                <output expression="&quot;Masukkan PIN: &quot;" newline="True"/>
                <input variable="pinInput"/>
                <if expression="pinInput = &quot;123456&quot;">
                    <then>
                        <output expression="&quot;Akses Diterima. Selamat Datang!&quot;" newline="True"/>
                        <assign variable="berhasil" expression="True"/>
                    </then>
                    <else>
                        <assign variable="kesempatan" expression="kesempatan - 1"/>
                        <if expression="kesempatan &gt; 0">
                            <then>
                                <output expression="&quot;PIN SALAH! Sisa Kesempatan: &quot; &amp; kesempatan" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;Kartu ATM Anda Diblokir!&quot;" newline="True"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
