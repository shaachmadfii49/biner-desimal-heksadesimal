    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="bilangan" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan angka : &quot;" newline="True"/>
            <input variable="bilangan"/>
            <if expression="bilangan % 2 = 0">
                <then>
                    <output expression="&quot;genap&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;ganjil&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
