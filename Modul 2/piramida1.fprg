<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="piramida1"/>
        <attribute name="authors" value="Keisha Achmad YK"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 10:18:32 AM"/>
        <attribute name="created" value="S2Vpc2hhIEFjaG1hZCBZSztLRUlTSEFBQ0hNQURGSUE7MjAyNi0wOS0xNjswOToxNjo1OSBQTTszNzU4"/>
        <attribute name="edited" value="S2Vpc2hhIEFjaG1hZCBZSztLRUlTSEFBQ0hNQURGSUE7MjAyNi0wOS0yMDsxMDoxODozMiBBTTs0OzM4MzQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N, i, j" type="Integer" array="False" size=""/>
            <output expression="&quot;Tinggi : &quot;" newline="True"/>
            <input variable="N"/>
            <assign variable="i" expression="1"/>
            <while expression="i &lt;= N">
                <assign variable="j" expression="1"/>
                <while expression="j &lt;= i">
                    <output expression="j" newline="False"/>
                    <output expression="&quot; &quot;" newline="False"/>
                    <assign variable="j" expression="j + 1"/>
                </while>
                <output expression="&quot; &quot;" newline="True"/>
                <assign variable="i" expression="i + 1"/>
            </while>
        </body>
    </function>
</flowgorithm>
