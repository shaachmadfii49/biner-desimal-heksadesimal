    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N, i, j, k" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan N (Tinggi) : &quot;" newline="True"/>
            <input variable="N"/>
            <for variable="i" start="1" end="N" direction="inc" step="1">
                <for variable="k" start="1" end="i" direction="inc" step="1">
                    <output expression="k &amp; &quot; &quot;" newline="False"/>
                </for>
                <output expression="&quot;&quot;" newline="True"/>
            </for>
            <output expression="&quot;&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
